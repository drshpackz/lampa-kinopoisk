# Шаблон /etc/kp-proxy.env — настоящий файл с правами 600, в репозиторий не кладётся.
#
# Несколько ключей через запятую: исчерпанный (403) или отвергнутый (401)
# выключается до конца суток, запрос уходит со следующим.
#
#   kinopoisk.dev (api.poiskkino.dev) — ключ у бота @poiskkinodev_bot, 200 запросов/сутки
#   kinopoiskapiunofficial.tech       — регистрация на сайте, 500 запросов/сутки

KPDEV_TOKENS=ваш-ключ-kinopoisk-dev
KPU_TOKENS=ваш-ключ-kinopoiskapiunofficial
